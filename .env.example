# Solace — Docker Compose Environment
# Copy this file to .env and adjust values

# Backend
BACKEND_PORT=8080
CLIENT_ORIGIN=http://localhost:3000
TURN_HOST=localhost
TURN_PORT=3478
TURN_USER=solace
TURN_PASSWORD=changeme
TURN_REALM=solace.local

# YouTube track resolution
# Residential proxy exit — YouTube bot-walls datacenter IPs. A residential
# proxy (socks5://user:pass@host:port) makes extraction reliably work.
# YT_DLP_PROXY=socks5://user:pass@host:port
# Optional: cookies file for yt-dlp (fallback, expires periodically)
# YT_COOKIES_FILE=/app/cookies.txt

# Frontend
# IMPORTANT: must use Docker-internal hostname (service name), not localhost
NEXT_PUBLIC_BACKEND_URL=http://backend:8080
FRONTEND_PORT=3000
