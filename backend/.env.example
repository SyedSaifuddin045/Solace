# Backend Environment Variables
# =============================

# Server port (default: 8080)
PORT=8080

# Frontend origin for CORS (set to your Coolify frontend domain in production)
# Example: https://solace.yourdomain.com
CLIENT_ORIGIN=http://localhost:3000

# TURN server config (for WebRTC NAT traversal)
TURN_HOST=localhost
TURN_PORT=3478
TURN_USER=solace
TURN_PASSWORD=changeme
TURN_REALM=solace.local
